# Neon Postgres connection string (same pattern as MediConnect / ProxiGaz / COMIX-CI)
DATABASE_URL=postgresql://user:password@ep-xxxx.neon.tech/nexova_services?sslmode=require

# Port for the standalone tRPC HTTP server
PORT=4100

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:5173
